# Copy this file to `.env` and fill in real values.
# .env is gitignored -- never commit real secrets.

# --- Bridge HTTP server ------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=5000

# Shared secret the MT5 EA must send as the X-API-Key header on every
# request. Generate a strong random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=changeme-generate-a-real-random-key

# --- Webull OpenAPI mode --------------------------------------------------------
# "paper" (default) trades Webull's simulated/paper account -- real order
# flow, fake money. "live" trades your real brokerage account with real
# money. Paper and live use entirely separate credentials below, so you
# can bootstrap both ahead of time and just flip this + restart to switch.
# See README "Setting up Webull" for the recommended go-live progression.
WEBULL_MODE=paper

# "us" or "hk" etc -- must match the region your app keys were issued for.
# Shared by both modes.
WEBULL_REGION_ID=us

# --- Webull OpenAPI credentials: paper -----------------------------------------
# Generate at https://www.webull.com/center#openApiManagement (US) -- pick
# "paperTrade" access when applying. See README for the full flow.
WEBULL_PAPER_APP_KEY=
WEBULL_PAPER_APP_SECRET=
# Leave unset to auto-use the first account returned for this app key; set
# explicitly if it has access to more than one.
WEBULL_PAPER_ACCOUNT_ID=
# Webull's sandbox/paper endpoint. Rarely needs changing.
WEBULL_PAPER_API_ENDPOINT=api.sandbox.webull.com

# --- Webull OpenAPI credentials: live -------------------------------------------
# Generate separately from the paper key above -- pick live/production
# access when applying. Approval typically takes 1-2 business days.
WEBULL_LIVE_APP_KEY=
WEBULL_LIVE_APP_SECRET=
WEBULL_LIVE_ACCOUNT_ID=
# Leave unset to use the SDK's production default endpoint.
WEBULL_LIVE_API_ENDPOINT=

# Where the SDK persists its verified session tokens after the one-time
# mobile-app approval step (see scripts/webull_login.py). A "paper" and
# "live" subdirectory are created automatically underneath this so the two
# modes' sessions never collide. Must stay under /app/data so it survives
# container restarts.
WEBULL_TOKEN_DIR=/app/data/webull_token

# --- Trading behaviour ---------------------------------------------------------
# Keep this `true` until you've confirmed MT5 -> bridge requests look
# correct in the logs. When `true`, no order is ever sent to Webull.
DRY_RUN=true

# Optional: path (inside the container, so under /app/data if you want it
# to persist) to a JSON file mapping MT5 symbol names to Webull tickers,
# e.g. {"US500": "SPY"}. Leave unset to use MT5 symbols as-is.
SYMBOL_MAP_FILE=

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional: also write logs to a file under the mounted data volume.
LOG_FILE=
